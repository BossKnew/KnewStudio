{
  "name": "knewstudio",
  "version": "0.1.1",
  "private": true,
  "description": "Self-hosted image generation workspace with a secure Docker Compose deployment.",
  "author": "BossKnew",
  "contributors": ["BossKnew"],
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @knewstudio/api && npm run build -w @knewstudio/web",
    "test": "npm run test -w @knewstudio/api && npm run test -w @knewstudio/web",
    "lint": "npm run lint -w @knewstudio/api && npm run lint -w @knewstudio/web",
    "db:generate": "npm run db:generate -w @knewstudio/api",
    "db:migrate": "npm run db:migrate -w @knewstudio/api",
    "assets:backfill-thumbnails": "npm run assets:backfill-thumbnails -w @knewstudio/api",
    "licenses:check": "node scripts/check-licenses.mjs",
    "security-configs:check": "node scripts/check-security-configs.mjs",
    "compose-security:check": "node scripts/run-compose-security.mjs"
  },
  "engines": { "node": ">=24 <25" },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "argon2": true,
    "fsevents": false,
    "msgpackr-extract": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
