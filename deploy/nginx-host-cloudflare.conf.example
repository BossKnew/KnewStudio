# Install as /etc/nginx/sites-available/knewstudio after replacing the
# hostname and certificate paths. The Compose web service must listen only on
# 127.0.0.1:8080. Port 443 must also be restricted to Cloudflare IP ranges in
# the cloud firewall.

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name studio.example.com;

  ssl_certificate /etc/nginx/ssl/knewstudio-origin.pem;
  ssl_certificate_key /etc/nginx/ssl/knewstudio-origin.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:KnewStudioTLS:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # This file must contain real_ip_header CF-Connecting-IP plus every current
  # Cloudflare IPv4/IPv6 set_real_ip_from range. See the companion example.
  include /etc/nginx/snippets/cloudflare-real-ip.conf;

  client_max_body_size 21m;
  client_body_timeout 15s;
  client_header_timeout 15s;
  keepalive_timeout 30s;
  server_tokens off;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;

  location ~ ^/api/v1/generations/[^/]+/events$ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_hide_header Cache-Control;
    proxy_read_timeout 15m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-cache, no-transform" always;
    add_header X-Accel-Buffering no always;
  }

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 600s;
  }
}
