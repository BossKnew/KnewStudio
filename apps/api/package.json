{
  "name": "@knewstudio/api",
  "version": "0.1.0",
  "private": true,
  "description": "KnewStudio API and background worker.",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "secrets:rotate": "node dist/rotate-provider-secrets.js",
    "mfa:rotate-secrets": "node dist/rotate-mfa-secrets.js",
    "mfa:reset": "node dist/reset-mfa.js",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.19.0",
    "prisma": "^6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "ioredis": "^5.7.0",
    "ipaddr.js": "^2.2.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "stream-json": "^1.9.1",
    "undici": "^8.10.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/stream-json": "^1.7.8",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
